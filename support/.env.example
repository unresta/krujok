# Token of the support bot — a different bot from the main one, @BotFather.
SUPPORT_BOT_TOKEN=
# Group where ticket cards land and where moderators answer by replying.
# Add the bot to that group first. Numeric id looks like -1001234567890.
SUPPORT_CHAT=
# Who may open /admin in private. Comma-separated ids.
SUPPORT_ADMIN_IDS=
# Own database. In Docker it is /app/data/support.db.
SUPPORT_DB_PATH=support.db
# Main bot's database, read-only, to show the user's balance and history on a
# card. Leave empty to run fully standalone. In Docker: /app/main/bot.db
MAIN_DB_PATH=
